{
  "hosting": {
    "site": "aloisepropiedades",
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.md",
      "README.md",
      "FIREBASE_*.md",
      "XINTEL_*.md",
      "COMO_*.md",
      "GUIA_*.md",
      "debug-*.html",
      "test-*.html",
      "diagnostico-*.html"
    ],
    "rewrites": [
      {
        "source": "**/*.@(html|css|js|jpg|jpeg|png|gif|svg|webp|ico|json|txt)",
        "destination": "/:1"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      }
    ]
  }
}
